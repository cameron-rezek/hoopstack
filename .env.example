# Root environment file for docker compose.
#
#   cp .env.example .env
#
# These values feed all three services. api/.env.example and
# ingestion/.env.example remain the reference for running those components
# directly on the host, outside compose.

# ── Postgres ─────────────────────────────────────────────────
DB_NAME=nba_analytics
DB_USER=nba_admin
DB_PASSWORD=change_me

# Host port for postgres. Change if 5432 is already taken locally.
DB_PORT=5432

# ── API ──────────────────────────────────────────────────────
# Leave empty to disable API key auth. If set, the frontend build below picks
# up the same value and sends it as the X-API-Key header.
API_KEY=

# JSON array. Must include the origin the browser loads the frontend from.
CORS_ORIGINS=["http://localhost:3000"]

# ── Frontend ─────────────────────────────────────────────────
# Baked into the JS bundle at build time, so it has to be reachable from your
# browser — not from inside the compose network. Change this only if you remap
# the api service's published port.
NEXT_PUBLIC_API_URL=http://localhost:8000
