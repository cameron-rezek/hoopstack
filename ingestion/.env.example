# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_password_here

# Ingestion settings
REQUEST_DELAY_SECONDS=3.0
MAX_RETRIES=3
API_TIMEOUT=60
CHECKPOINT_DIR=./checkpoints
LOG_LEVEL=INFO

# Throttle cooldown: if N consecutive games fail, pause for COOLDOWN_SECONDS
# to let the NBA API rate limit window reset before continuing.
COOLDOWN_THRESHOLD=3
COOLDOWN_SECONDS=300
